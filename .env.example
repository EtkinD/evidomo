# Copy to .env for local development. Never commit .env.

# API and worker
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://evidomo:evidomo@localhost:5432/evidomo
MODEL_API_KEY=meta_model_api_key
# Global cap on estimated model spend per UTC day (USD, exact decimal; 0 stops all model calls).
# Defaults to 5.00 in development and test; required in production.
DAILY_BUDGET_USD=5.00
# Directory with services/ and markets/ definition files, validated at boot. Leave unset to use
# the repository's definitions/ directory (also the default in the Docker image).
# DEFINITIONS_DIR=
