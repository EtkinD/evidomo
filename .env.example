# Copy to .env for local development. Never commit .env.

# API and worker
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://evidomo:evidomo@localhost:5432/evidomo
MODEL_API_KEY=meta_model_api_key
# Global cap on estimated model spend per UTC day (USD, exact decimal; 0 stops all model calls).
# Defaults to 5.00 in development and test; required in production.
DAILY_BUDGET_USD=5.00
# Directory with services/ and markets/ definition files, validated at boot. Leave unset to use
# the repository's definitions/ directory (also the default in the Docker image).
# DEFINITIONS_DIR=
# Root of uploaded materials and generated files (absolute path). Defaults to <repo>/data/storage
# outside production; production uses the /data volume (infra/compose.yaml sets it).
# STORAGE_DIR=/absolute/path/to/storage
# Browser-facing origin of the web app. State-changing API requests from other origins are
# rejected; an https origin makes the session cookie Secure and __Host- prefixed. Defaults to the
# Next.js dev server outside production; required in production.
# APP_ORIGIN=http://localhost:3000
# Absolute session lifetime in days (1-365). Default 30.
# SESSION_TTL_DAYS=30
# Reverse-proxy hops trusted for the client IP (rate limits). Default 0 outside production
# (no proxy, X-Forwarded-For ignored) and 1 in production (Caddy).
# TRUST_PROXY_HOPS=0
# Access code for starting live runs (P4-10), API only. Optional outside production (unset: a
# session is enough); required in production. 12-256 characters without surrounding whitespace,
# e.g. `openssl rand -base64 18`. Never commit a real value.
# LIVE_RUN_ACCESS_CODE=
# Run starts per account and per client IP per 24 hours, and wrong access codes per client IP
# per hour (in-process limits; defaults 3, 5, 10).
# RUN_STARTS_PER_ACCOUNT_PER_DAY=3
# RUN_STARTS_PER_IP_PER_DAY=5
# ACCESS_CODE_FAILURES_PER_IP_PER_HOUR=10
# Comma-separated run UUIDs the public demo API serves (completed runs only; P4-09). Every listed
# run becomes public without login: list only synthetic runs made by `npm run demo:seed`.
# DEMO_RUN_IDS=
# Whether run and demo API responses include run costs: snapshot and live costs, the cap, and
# the amounts in budget failure reasons (true/false). Costs are for operators: default true
# outside production, false in production. The usage ledger and the caps work the same either way.
# RUN_COSTS_VISIBLE=true
