{
  "name": "evidomo",
  "version": "0.4.0",
  "private": true,
  "description": "Evidomo — evidence for every home. Verified, source-linked listing packs for real estate agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @evidomo/web",
    "dev:api": "npm run dev -w @evidomo/api",
    "dev:worker": "npm run dev:worker -w @evidomo/api",
    "pipeline": "node --env-file-if-exists=.env apps/api/src/cli/pipeline.ts",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project shared --project api --project web",
    "test:integration": "vitest run --project api-integration",
    "test:e2e": "playwright test",
    "audit:deps": "env -u npm_config_allow_scripts npm audit --audit-level=moderate && env -u npm_config_allow_scripts npm audit signatures",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @evidomo/api",
    "db:migrate": "npm run db:migrate -w @evidomo/api",
    "preversion": "npm run lint && npm run typecheck && npm test && npm run audit:deps"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
