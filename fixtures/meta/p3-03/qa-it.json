                  {
                    "type": "output_text",
                    "text": "{\"cards\": [{\"answer\": [{\"factIds\": [\"VF02\", \"VF48\"], \"text\": \"La superficie abitabile \\u00e8 di 92 m\\u00b2 secondo NEN 2580 e l'appartamento conta 3 ambienti.\"}], \"question\": \"Qual \\u00e8 la superficie e la distribuzione degli ambienti?\"}, {\"answer\": [{\"factIds\": [\"VF43\", \"VF46\", \"VF44\"], \"text\": \"Il soggiorno a L misura 34 m\\u00b2 e ha pavimento in parquet di rovere.\"}, {\"factIds\": [\"VF40\", \"VF38\", \"VF42\"], \"text\": \"La cucina angolare aperta si trova sul retro del soggiorno e risale al 2021.\"}], \"question\": \"Com\\u2019\\u00e8 la zona giorno?\"}, {\"answer\": [{\"factIds\": [\"VF28\", \"VF29\", \"VF59\"], \"text\": \"La camera da letto principale misura 14 m\\u00b2 e si trova sul lato anteriore, mentre la seconda camera misura 9 m\\u00b2.\"}, {\"factIds\": [\"VF15\", \"VF16\"], \"text\": \"Il bagno si trova tra le due camere e risale al 2021.\"}], \"question\": \"Com\\u2019\\u00e8 la zona notte?\"}, {\"answer\": [{\"factIds\": [\"VF01\", \"VF35\", \"VF34\"], \"text\": \"L\\u2019etichetta energetica \\u00e8 B e il riscaldamento avviene con caldaia HR del 2019.\"}, {\"factIds\": [\"VF24\"], \"text\": \"Sono presenti doppi vetri.\"}], \"question\": \"Qual \\u00e8 la situazione energetica e il riscaldamento?\"}, {\"answer\": [{\"factIds\": [\"VF04\", \"VF71\", \"VF56\", \"VF47\"], \"text\": \"Il contributo mensile \\u00e8 di \\u20ac165 e l\\u2019associazione \\u00e8 attiva con fondo di riserva e piano di manutenzione.\"}], \"question\": \"Quali sono gli oneri dell\\u2019associazione dei proprietari?\"}, {\"answer\": [{\"factIds\": [\"VF13\", \"VF14\", \"VF12\"], \"text\": \"Il balcone misura 7 m\\u00b2, \\u00e8 orientato a sud-ovest e si raggiunge tramite porte-finestre dal soggiorno.\"}], \"question\": \"Com\\u2019\\u00e8 lo spazio esterno?\"}, {\"answer\": [{\"factIds\": [\"VF66\", \"VF52\", \"VF64\", \"VF51\"], \"text\": \"Supermercato e scuola primaria sono raggiungibili a piedi e la stazione dista 10 minuti in bicicletta a Zandmeer.\"}], \"question\": \"Come sono i dintorni?\"}, {\"answer\": [{\"factIds\": [\"VF50\", \"VF49\", \"VF26\"], \"text\": \"Il parcheggio si trova davanti alla porta senza regime a pagamento e il deposito esterno misura 6 m\\u00b2.\"}], \"question\": \"Come sono il parcheggio e il deposito?\"}]}",
