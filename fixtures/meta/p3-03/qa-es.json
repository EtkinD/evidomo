                  {
                    "type": "output_text",
                    "text": "{\"cards\": [{\"answer\": [{\"factIds\": [\"VF02\"], \"text\": \"La superficie habitable es de 92 m\\u00b2.\"}, {\"factIds\": [\"VF48\"], \"text\": \"Tiene 3 habitaciones.\"}], \"question\": \"\\u00bfCu\\u00e1l es la superficie y la distribuci\\u00f3n?\"}, {\"answer\": [{\"factIds\": [\"VF46\", \"VF43\"], \"text\": \"El sal\\u00f3n en forma de L mide 34 m\\u00b2.\"}, {\"factIds\": [\"VF44\"], \"text\": \"Tiene suelo de parqu\\u00e9 de roble.\"}], \"question\": \"\\u00bfC\\u00f3mo es el sal\\u00f3n?\"}, {\"answer\": [{\"factIds\": [\"VF40\", \"VF38\"], \"text\": \"La cocina de esquina es abierta y est\\u00e1 en la parte trasera del sal\\u00f3n.\"}, {\"factIds\": [\"VF42\", \"VF41\"], \"text\": \"Es de 2021 y tiene encimera composite.\"}], \"question\": \"\\u00bfC\\u00f3mo es la cocina?\"}, {\"answer\": [{\"factIds\": [\"VF01\"], \"text\": \"Tiene etiqueta energ\\u00e9tica B.\"}, {\"factIds\": [\"VF35\", \"VF34\"], \"text\": \"La calefacci\\u00f3n es por caldera HR de 2019.\"}], \"question\": \"\\u00bfC\\u00f3mo es la etiqueta energ\\u00e9tica y la calefacci\\u00f3n?\"}, {\"answer\": [{\"factIds\": [\"VF13\", \"VF14\"], \"text\": \"El balc\\u00f3n mide 7 m\\u00b2 y est\\u00e1 orientado al suroeste.\"}, {\"factIds\": [\"VF12\", \"VF11\"], \"text\": \"Se accede por puertas francesas desde el sal\\u00f3n y tiene toldo el\\u00e9ctrico.\"}], \"question\": \"\\u00bfC\\u00f3mo es el espacio exterior?\"}, {\"answer\": [{\"factIds\": [\"VF50\"], \"text\": \"El aparcamiento est\\u00e1 delante de la puerta.\"}, {\"factIds\": [\"VF49\"], \"text\": \"No hay aparcamiento de pago.\"}], \"question\": \"\\u00bfD\\u00f3nde se puede aparcar?\"}, {\"answer\": [{\"factIds\": [\"VF04\"], \"text\": \"La aportaci\\u00f3n mensual a la VvE es de 165 \\u20ac.\"}, {\"factIds\": [\"VF71\", \"VF62\", \"VF63\", \"VF56\"], \"text\": \"La VvE est\\u00e1 activa e incluye seguro del edificio, mantenimiento com\\u00fan y fondo de reserva.\"}], \"question\": \"\\u00bfCu\\u00e1les son los gastos de la comunidad?\"}, {\"answer\": [{\"factIds\": [\"VF51\", \"VF66\", \"VF52\"], \"text\": \"Est\\u00e1 en Zandmeer, con supermercado y escuela primaria a poca distancia a pie.\"}, {\"factIds\": [\"VF64\"], \"text\": \"La estaci\\u00f3n est\\u00e1 a 10 minutos en bicicleta.\"}], \"question\": \"\\u00bfQu\\u00e9 hay en los alrededores?\"}]}",
