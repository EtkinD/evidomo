                  {
                    "type": "output_text",
                    "text": "{\"cards\": [{\"answer\": [{\"factIds\": [\"VF02\"], \"text\": \"Het woonoppervlak is 92 m\\u00b2.\"}], \"question\": \"Hoe groot is het woonoppervlak?\"}, {\"answer\": [{\"factIds\": [\"VF48\", \"VF46\", \"VF43\"], \"text\": \"De woning heeft 3 kamers met een L-vormige woonkamer van 34 m\\u00b2.\"}, {\"factIds\": [\"VF28\", \"VF29\", \"VF30\"], \"text\": \"De slaapkamer aan de voorzijde is 14 m\\u00b2 met een inbouwkast over de volledige breedte.\"}, {\"factIds\": [\"VF59\", \"VF60\"], \"text\": \"De andere kamer is 9 m\\u00b2 en in gebruik als thuiskantoor.\"}], \"question\": \"Hoe is de woning ingedeeld?\"}, {\"answer\": [{\"factIds\": [\"VF01\"], \"text\": \"Het energielabel is B.\"}, {\"factIds\": [\"VF35\", \"VF34\"], \"text\": \"De verwarming gebeurt met een HR-ketel uit 2019.\"}, {\"factIds\": [\"VF24\", \"VF45\"], \"text\": \"De woning heeft dubbel glas en HR++ glas in de woonkamer.\"}], \"question\": \"Hoe zijn het energielabel en de verwarming geregeld?\"}, {\"answer\": [{\"factIds\": [\"VF03\"], \"text\": \"Het bouwjaar is 1987.\"}, {\"factIds\": [\"VF58\", \"VF42\", \"VF16\"], \"text\": \"Het dak is vernieuwd in 2020 en de keuken en badkamer zijn vernieuwd in 2021.\"}], \"question\": \"In welk jaar is de woning gebouwd?\"}, {\"answer\": [{\"factIds\": [\"VF04\"], \"text\": \"De maandelijkse VvE-bijdrage is \\u20ac165.\"}, {\"factIds\": [\"VF71\", \"VF56\", \"VF47\"], \"text\": \"De VvE is actief met een reservefonds en een onderhoudsplan.\"}, {\"factIds\": [\"VF62\", \"VF63\"], \"text\": \"De bijdrage is inclusief opstalverzekering en gemeenschappelijk onderhoud.\"}], \"question\": \"Wat betaal je maandelijks aan de vereniging van eigenaren?\"}, {\"answer\": [{\"factIds\": [\"VF13\", \"VF14\"], \"text\": \"Het balkon is 7 m\\u00b2 en ligt op het zuidwesten.\"}, {\"factIds\": [\"VF12\"], \"text\": \"Het balkon is bereikbaar via openslaande deuren vanuit de woonkamer.\"}, {\"factIds\": [\"VF07\", \"VF11\"], \"text\": \"Er is middagzon en een elektrisch bedienbaar zonnescherm.\"}], \"question\": \"Hoe ziet de buitenruimte eruit?\"}, {\"answer\": [{\"factIds\": [\"VF50\"], \"text\": \"Parkeren kan voor de deur.\"}, {\"factIds\": [\"VF49\"], \"text\": \"Er geldt geen betaald parkeren.\"}], \"question\": \"Hoe is het parkeren geregeld?\"}, {\"answer\": [{\"factIds\": [\"VF51\", \"VF66\", \"VF52\"], \"text\": \"De woning ligt in Zandmeer met een supermarkt en een basisschool op loopafstand.\"}, {\"factIds\": [\"VF64\"], \"text\": \"Het station is op 10 minuten fietsen.\"}], \"question\": \"Hoe is de omgeving van de woning?\"}]}",
