                  {
                    "type": "output_text",
                    "text": "{\"cards\": [{\"answer\": [{\"factIds\": [\"VF02\"], \"text\": \"The living area is 92 m\\u00b2.\"}, {\"factIds\": [\"VF48\"], \"text\": \"The apartment has 3 rooms.\"}], \"question\": \"How large is the living area and how many rooms does it have?\"}, {\"answer\": [{\"factIds\": [\"VF46\", \"VF43\", \"VF44\"], \"text\": \"The L-shaped living room measures 34 m\\u00b2 and has an oak parquet floor.\"}, {\"factIds\": [\"VF38\", \"VF40\", \"VF42\", \"VF41\"], \"text\": \"The open corner kitchen sits at the rear of the living room, dates from 2021 and has a composite worktop.\"}], \"question\": \"What are the living room and kitchen like?\"}, {\"answer\": [{\"factIds\": [\"VF28\", \"VF29\", \"VF30\"], \"text\": \"The front bedroom is 14 m\\u00b2 with a fitted wardrobe over the full width.\"}, {\"factIds\": [\"VF59\", \"VF60\", \"VF15\"], \"text\": \"The second bedroom is 9 m\\u00b2 and is used as a home office, with the bathroom between the two bedrooms.\"}], \"question\": \"What are the bedrooms and bathroom like?\"}, {\"answer\": [{\"factIds\": [\"VF01\"], \"text\": \"The energy label is B.\"}, {\"factIds\": [\"VF35\", \"VF34\"], \"text\": \"Heating is provided by an HR boiler from 2019.\"}, {\"factIds\": [\"VF24\", \"VF45\"], \"text\": \"The property has double glazing, including HR++ glass in the living room.\"}], \"question\": \"How is the home heated and how energy efficient is it?\"}, {\"answer\": [{\"factIds\": [\"VF04\"], \"text\": \"The monthly owners\\u2019 association contribution is \\u20ac165.\"}, {\"factIds\": [\"VF71\", \"VF70\", \"VF56\", \"VF47\"], \"text\": \"The active owners\\u2019 association covers 12 dwellings and has a reserve fund and maintenance plan.\"}, {\"factIds\": [\"VF62\", \"VF63\", \"VF05\"], \"text\": \"The contribution covers building insurance and common maintenance, and the land is not under ground lease.\"}], \"question\": \"What are the owners\\u2019 association costs and arrangements?\"}, {\"answer\": [{\"factIds\": [\"VF13\", \"VF14\", \"VF12\"], \"text\": \"The balcony is 7 m\\u00b2, faces southwest and is accessed by French doors from the living room.\"}, {\"factIds\": [\"VF11\", \"VF07\"], \"text\": \"It has a sunshade with electric operation and afternoon sun.\"}], \"question\": \"What outdoor space is available?\"}, {\"answer\": [{\"factIds\": [\"VF50\", \"VF49\"], \"text\": \"Parking is in front of the door and there is no paid parking.\"}, {\"factIds\": [\"VF26\"], \"text\": \"There is external storage of 6 m\\u00b2.\"}], \"question\": \"Where can parking and storage be found?\"}, {\"answer\": [{\"factIds\": [\"VF66\", \"VF52\", \"VF51\"], \"text\": \"In Zandmeer, a supermarket and primary school are within walking distance.\"}, {\"factIds\": [\"VF64\"], \"text\": \"The station is 10 minutes away by bicycle.\"}], \"question\": \"What is available in the surrounding area?\"}]}",
