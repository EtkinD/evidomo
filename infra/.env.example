# Production stack variables for infra/compose.yaml.
# Copy to infra/.env on the server, fill in, and `chmod 600 infra/.env`. Never commit it.
# Compose interpolates these into each service explicitly; see the header of compose.yaml.

# Site address for Caddy. ":80" serves plain HTTP on any host name (local run).
# A bare domain such as "evidomo.example" enables automatic HTTPS (D-03).
SITE_ADDRESS=:80
# Host ports Caddy publishes. Production keeps 80/443; change locally if they are taken.
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL. The password is embedded in DATABASE_URL, so keep it URL-safe:
#   openssl rand -hex 32
POSTGRES_USER=evidomo
POSTGRES_PASSWORD=
POSTGRES_DB=evidomo

# API and worker
LOG_LEVEL=info
# Meta Model API key. Passed to api and worker only.
MODEL_API_KEY=
# Global cap on estimated model spend per UTC day, in USD (exact decimal, e.g. 10.00).
# Required: api and worker refuse to start without it. 0 stops all model calls.
DAILY_BUDGET_USD=
# Public origin of the site as the browser sees it: https://<SITE_ADDRESS domain>, no path.
# Required: api and worker refuse to start without it. http is accepted only for localhost
# (e.g. http://localhost for a local run with SITE_ADDRESS=:80).
APP_ORIGIN=

# API only
# Access code for starting live runs (P4-10). Required: compose refuses to start without it.
# 12-256 characters without surrounding whitespace, e.g. `openssl rand -base64 18`.
LIVE_RUN_ACCESS_CODE=
# Optional limits (empty = default): run starts per account and per client IP per 24 hours, and
# wrong access codes per client IP per hour.
RUN_STARTS_PER_ACCOUNT_PER_DAY=
RUN_STARTS_PER_IP_PER_DAY=
ACCESS_CODE_FAILURES_PER_IP_PER_HOUR=
# Completed demo runs served publicly without login, comma-separated run UUIDs (P4-09). Every
# listed run becomes public: only runs printed by the demo-seed service belong here.
DEMO_RUN_IDS=
# Reverse-proxy hops trusted for the client IP. Empty = 1 (Caddy); change only with another proxy.
TRUST_PROXY_HOPS=
