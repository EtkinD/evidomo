# Production stack variables for infra/compose.yaml.
# On the server: `cp infra/.env.example infra/.env`, fill in, then `chmod 600 infra/.env` as the
# deploy user (infra/deploy.sh refuses to run if group or others can read it). Never commit it.
# Compose interpolates these into each service explicitly; see the header of compose.yaml.
# Values are plain KEY=value: no quotes, no spaces around "=", no trailing comments.

# ---- Domain and HTTPS (Caddy) -------------------------------------------------------------
# The canonical host name, bare: no scheme, no path. A domain turns on automatic HTTPS.
# ":80" serves plain HTTP on any host name (local runs only; deploy.sh refuses it with an https
# APP_ORIGIN).
SITE_ADDRESS=:80
# Redirects to SITE_ADDRESS (permanent), e.g. www.evidomo.example. Needs its own DNS record.
# Leave empty to disable.
WWW_ADDRESS=
# Seconds for Strict-Transport-Security. Start at 300; after HTTPS has worked for a day, raise
# it to 31536000 and run `infra/deploy.sh` again (a browser remembers HSTS: do not raise it
# before every subdomain you use works over HTTPS).
HSTS_MAX_AGE=300
# ACME directory. Empty = Let's Encrypt production. For a first dry run use the staging directory
# https://acme-staging-v02.api.letsencrypt.org/directory (browsers distrust its certificates).
ACME_CA=
# Host ports Caddy publishes. Production keeps 80/443; change locally if they are taken.
HTTP_PORT=80
HTTPS_PORT=443

# Public origin of the site as the browser sees it: https://<SITE_ADDRESS>, no path, no trailing
# slash. Required: api and worker refuse to start without it (CSRF Origin check, Secure
# __Host- session cookie). http is accepted only for localhost.
APP_ORIGIN=
# Same value as APP_ORIGIN. A BUILD argument of the web image (inlined into the client bundle so
# og:image URLs are absolute), not a runtime variable; changing it needs a rebuild (deploy.sh).
NEXT_PUBLIC_SITE_ORIGIN=

# ---- Database (PostgreSQL) ----------------------------------------------------------------
# Not reachable from outside the compose network. The password is embedded in DATABASE_URL, so
# keep it URL-safe: `openssl rand -hex 32`. Changing it later does not change the existing
# database user (the data volume keeps the old one); set it once.
POSTGRES_USER=evidomo
POSTGRES_PASSWORD=
POSTGRES_DB=evidomo

# ---- API and worker -----------------------------------------------------------------------
LOG_LEVEL=info
# Meta Model API key. Passed to api and worker only (never web, caddy, backup, demo-seed).
MODEL_API_KEY=
# Global cap on estimated model spend per UTC day, in USD (exact decimal, e.g. 10.00).
# Required: api and worker refuse to start without it. 0 stops all model calls.
DAILY_BUDGET_USD=

# ---- API only -----------------------------------------------------------------------------
# Access code for starting live runs (P4-10). Required: compose refuses to start without it.
# 12-256 characters without surrounding whitespace: `openssl rand -base64 18`.
LIVE_RUN_ACCESS_CODE=
# Optional limits (empty = default): run starts per account and per client IP per 24 hours, and
# wrong access codes per client IP per hour.
RUN_STARTS_PER_ACCOUNT_PER_DAY=
RUN_STARTS_PER_IP_PER_DAY=
ACCESS_CODE_FAILURES_PER_IP_PER_HOUR=
# Completed demo runs served publicly without login, comma-separated run UUIDs (P4-09). Every
# listed run becomes public: only runs printed by the demo-seed service belong here. Empty until
# you have run demo-seed (infra/README.md, "Demo run").
DEMO_RUN_IDS=
# Reverse-proxy hops trusted for the client IP. Empty = 1 (Caddy); change only with another proxy.
TRUST_PROXY_HOPS=
# Send run costs (spend, cap, budget amounts in failure reasons) to browsers: true/false.
# Leave EMPTY on a public deployment: empty = hidden in production, costs stay in the database
# (usage ledger) for operators. Set true only on a deployment that operators alone use.
RUN_COSTS_VISIBLE=

# ---- Backups ------------------------------------------------------------------------------
# Time of the daily backup, UTC, HHMM. Seven daily and four weekly backups are kept.
BACKUP_AT=0315

# ---- Resources and replicas ---------------------------------------------------------------
# Limits per container (compose deploy.resources.limits); an empty value means the default shown.
# The defaults fit the documented minimum host (4 GB RAM, 2 vCPU). On a larger host raise them
# and WEB_REPLICAS using the sizing rule in infra/README.md ("Sizing"): everything that runs all
# the time must add up to at most 80% of the host's CPU and RAM. infra/deploy.sh warns when it
# does not. *_CPUS is a number of vCPUs (0.5 = half a core), *_MEMORY a size such as 512M or 1G.
# Copies of the web app behind Caddy. web is stateless, so any number works; the limits below
# are per copy. The api and the worker are single instances (infra/README.md explains why).
WEB_REPLICAS=1
CADDY_CPUS=0.15
CADDY_MEMORY=128M
WEB_CPUS=0.3
WEB_MEMORY=384M
API_CPUS=0.3
API_MEMORY=384M
WORKER_CPUS=0.4
WORKER_MEMORY=1G
POSTGRES_CPUS=0.3
POSTGRES_MEMORY=768M
BACKUP_CPUS=0.1
BACKUP_MEMORY=128M

# ---- Load test window (infra/README.md, "Load test") ---------------------------------------
# Leave EMPTY. The public demo API limits each client IP to 2000 requests per 15 minutes and 3
# open replay streams; a load test sends everything from one address and would only measure
# those limits. For the test window set both (for example 10000000 and 1000), run
# `docker compose ... up -d --wait api`, and empty them again afterwards.
DEMO_REQUESTS_PER_IP_PER_15_MIN=
DEMO_STREAMS_PER_IP=
