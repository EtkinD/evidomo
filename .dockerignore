# Build context is the repository root. Keep it to sources and manifests: no secrets,
# no host-built artifacts, no local data.

# Secrets and environment files (including examples; images never read them)
**/.env
**/.env.*

# VCS and tooling
.git
.github
.claude
.vscode
.idea
**/.DS_Store
**/*.log

# Dependencies and build output (rebuilt inside the image for the target platform)
**/node_modules
**/.next
**/.next-e2e
**/out
**/dist
**/*.tsbuildinfo
apps/web/next-env.d.ts

# Tests and test output
**/*.test.ts
**/*.test.tsx
**/__tests__
e2e
coverage
playwright-report
test-results
blob-report
playwright.config.ts
vitest.config.ts

# Local data
**/uploads
**/data
# Dev-only design exploration images (gitignored; public/ is copied into the web image)
apps/web/public/showcase-assets
# The dev-only design showcase never ships (its routes use a dev-only page extension) and
# reads test fixtures, which are not in the build context either.
apps/web/src/showcase
apps/web/src/pages/showcase

# Not needed in any image
apps/web/scripts
docs
infra
docker-compose.yml
**/Dockerfile
README.md
CLAUDE.md
**/AGENTS.md
