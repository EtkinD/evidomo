{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    // @evidomo/shared is raw TypeScript for Node type stripping, so its relative imports end in
    // `.ts`. The web app's own imports stay extensionless (bundler resolution).
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    "next.config.ts",
    "postcss.config.mjs"
  ],
  "exclude": ["node_modules"]
}
